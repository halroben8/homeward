; Engine configuration file.
; Homeward — Godot 4.2 / 4.3 compatible. Mobile-first, LANDSCAPE.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Homeward"
config/description="HOMEWARD 3D: a cute orange tabby must remember the random address on his collar tag and find his way home, avoiding well-meaning people who want to take him home with them."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/sprites/cat.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"
; v1.0 step 3 (motion): vsync ON (already the engine default — pinned
; explicitly so nothing can drift it). The panel paces presentation;
; physics below is matched to the panel so no presented frame ever
; shows a stale physics position.
window/vsync/vsync_mode=1

[physics]

; v1.0 step 3 (motion): 120 physics ticks/sec, up from the 60 default.
; Michael's phone panel presents at 120 Hz. At 60 ticks the cat and the
; residents only moved on every OTHER presented frame — measured with
; tests/motion_probe.gd: 50% of presented frames showed an unchanged
; cat position, then a double-size 0.19-unit hop, while the camera
; (smoothed per rendered frame) glided smoothly. That step-against-
; glide mismatch is the judder / "seeing double" at speed. Godot 4.2.2
; has no physics/common/physics_interpolation setting (that arrived in
; 4.3 — verified: ProjectSettings.has_setting() is false on this
; binary), so matching the tick rate to the display is the 4.2 route
; to the same result: every presented frame now gets a fresh physics
; position and the per-frame step halves. All movement/AI/timer code
; in this project is delta-based (the 60.0s pursuit timer runs on
; render delta in _process), so the tick change alters no speeds,
; timings or gameplay. If a panel presents at 60 Hz instead, two
; physics steps land per frame — still uniform, still smooth.
common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.45, 0.72, 0.42, 1)
